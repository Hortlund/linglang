package main

func main() {
	var items Map[int, int]
	for i := 0; i < 10000; i++ {
		items = put(items, i, i*2)
	}
	total := 0
	for i := 0; i < 10000; i++ {
		found := get(items, i)
		assert(found.ok)
		total += found.value
		if i%2 == 0 {
			items = remove(items, i)
		}
	}
	assert(total == 99990000 && len(items) == 5000)
}
