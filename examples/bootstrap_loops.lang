package main

// A tiny ASCII identifier counter that the linglang-written emitter can compile.
func countIdentifiers(text string) int {
	count := 0
	i := 0
	for i < len(text) {
		if !isLetter(byteAt(text, i)) {
			i++
			continue
		}
		count++
		for {
			i++
			if i == len(text) || !isLetter(byteAt(text, i)) {
				break
			}
		}
	}
	return count
}

func main() {
	text := "beans = 55; println(beans)"
	assert(countIdentifiers(text) == 3)
	println("identifiers:", countIdentifiers(text))
	total := 0
	for i := 0; i < 1000; i++ {
		total += i
	}
	assert(total == 499500)
	println("loop sum:", total)
}
