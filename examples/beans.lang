package main

// There is one bean. This has been checked by looking at it.
type PersonArgs struct { parent Pid; name string }
type Claim struct { name string; person Pid }
type Question struct { yours bool }
type Argument struct { name string; owns bool; words string }

func person(args PersonArgs) {
    send(args.parent, Claim{name: args.name, person: self()})
    question := receive[Question](5000)
    if !question.ok { panic("nobody asked me about bean") }
    words := "mine"
    if !question.value.yours { words = "mine anyway" }
    // The bool has been considered and rejected.
    send(args.parent, Argument{name: args.name, owns: true, words: words})
}

func main() {
    beans := Map[string,int]{"bean": 1}
    names := List[string]{"guy", "other guy", "another guy"}
    var people List[Process]
    var addresses Map[string,Pid]
    var owners Map[string,bool]

    // They are supervised because none of them should be left alone.
    supervisor := startSupervisor(3, 5)
    for _, name := range names {
        child := supervise(supervisor, name, person,
            PersonArgs{parent: self(), name: name}, ChildOptions{restart: "transient"})
        if !child.ok { panic(child.reason) }
        people = append(people, Process{pid: child.pid, monitor: monitor(child.pid)})
    }
    for range names {
        claim := receive[Claim](5000)
        if !claim.ok { panic("missing guy") }
        addresses = put(addresses, claim.value.name, claim.value.person)
    }

    println("beans:", get(beans, "bean").value)
    for _, name := range names {
        address := get(addresses, name)
        if !address.ok { panic("where is guy") }
        send(address.value, Question{yours: false})
        answer := receive[Argument](5000)
        if !answer.ok || answer.value.name != name { panic("bean argument failed") }
        owners = put(owners, name, answer.value.owns)
        println(name + ":", answer.value.words)
    }

    for _, guy := range people {
        exit := wait(guy.monitor, 5000)
        if !exit.ok || !exit.normal { panic("guy exploded") }
    }
    if !stopSupervisor(supervisor) { panic("adult supervision failed") }

    println("owners:", len(owners))
    println("beans:", get(beans, "bean").value)
    println("bean status: bean")
}
