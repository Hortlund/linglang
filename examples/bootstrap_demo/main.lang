package main

const title = "compiler has entered the chat"

func main() {
	println(title)
	beans := fibonacci(10)
	flags := 13
	flags &^= 5
	flags <<= 1
	if beans == 55 && flags == 16 {
		println("55 beans. all accounted for.")
	} else {
		panic("the compiler ate the beans")
	}
	{
		beans := "this bean has its own scope"
		println(beans)
	}
	println("actual answer:", beans)
	println("receipt: " + formatInt(flags))
}
