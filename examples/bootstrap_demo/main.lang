package main

const title = "Bootstrap compiler example"

func main() {
	println(title)
	result := fibonacci(10)
	flags := 13
	flags &^= 5
	flags <<= 1
	if result == 55 && flags == 16 {
		println("calculation verified")
	} else {
		panic("unexpected calculation result")
	}
	{
		result := "local scope"
		println(result)
	}
	println("fibonacci:", result)
	println("flags: " + formatInt(flags))
}
