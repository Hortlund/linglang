{
  "type": "object",
  "required": [
    "schemaVersion",
    "compiler",
    "stability",
    "commands",
    "capabilities",
    "nativeAPI",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "compiler": {
      "enum": [
        "go-seed",
        "bootstrap"
      ]
    },
    "stability": {
      "const": "experimental"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "usage",
          "summary"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "usage": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "notes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "supported",
              "limited",
              "unavailable"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "nativeAPI": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "declaration"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "function",
              "record",
              "collection",
              "opaque"
            ]
          },
          "declaration": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linglang capability description, version 1"
}
