package main

type IterationNode struct {
	value int
}

func iterationNode(value int) *IterationNode {
	return &IterationNode{value: value}
}

func iterationChurn() {
	for i := 0; i < 40; i++ {
		p := &IterationNode{value: i}
		assert(p.value == i)
	}
}

func iterationCondition(p *int) bool {
	*p++
	iterationChurn()
	return *p < 6
}

func iterationReturn() *IterationNode {
	for i, p := 0, (&IterationNode{value: 7}); i < 3; i++ {
		iterationChurn()
		if i == 2 {
			return p
		}
	}
	return nil
}

func TestIterationStorage() {
	// Only j has observable iteration identity; i can reuse its cell.
	var saved List[*int]
	total := 0
	for i, j := 0, 10; i < 4; i, j = i+1, j+10 {
		saved = append(saved, &j)
		iterationChurn()
		if i == 1 {
			continue
		}
		total += i + j
		if i == 3 {
			break
		}
	}
	assert(total == 85 && len(saved) == 4)
	expected := 10
	var previous *int
	for _, p := range saved {
		assert(*p == expected && p != previous)
		previous = p
		expected += 10
	}
	// The condition can take/mutate the binding's address. Cloning occurs
	// after body/continue and before post, preserving each saved cell.
	var observed List[*int]
	for i := 0; iterationCondition(&i); i++ {
		observed = append(observed, &i)
	}
	assert(len(observed) == 3)
	assert(*head(observed).value == 1)
	assert(*head(tail(observed)).value == 3)
	assert(*head(tail(tail(observed))).value == 5)
	// Interior addresses must preserve identity too, even for value structs.
	var fields List[*int]
	for n := (IterationNode{}); n.value < 3; n.value++ {
		fields = append(fields, &n.value)
	}
	iterationChurn()
	assert(*head(fields).value == 0 && *head(tail(fields)).value == 1)
	// Pointer-bearing, unaddressed initializer cells remain rooted across GC,
	// simultaneous post assignment, nested scopes, and returning out of a loop.
	total = 0
	for p, i := iterationNode(1), 0; i < 3; p, i = iterationNode(p.value+1), i+1 {
		iterationChurn()
		for i := 0; i < 2; i++ {
			total += p.value
		}
	}
	assert(total == 12)
	result := iterationReturn()
	iterationChurn()
	assert(result.value == 7)
	// The loop counter retains signed wrapping and body writes feed post.
	steps := 0
	for i := 9223372036854775807; steps < 2; i++ {
		if steps == 1 {
			assert(i == -9223372036854775808)
		}
		steps++
	}
	total = 0
	for i := 0; i < 6; i++ {
		i++
		total += i
	}
	assert(total == 9)
}
