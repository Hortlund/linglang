	return ""
}

// Generic intrinsic schemes are implemented procedurally by nativeCall. Keep
// their public descriptions here; never expose the seed's opaque stand-ins.
func nativeGenericDeclaration(name string) NativeDeclaration {
	switch name {
	case "CallResult":
		return NativeDeclaration{name: "CallResult", kind: "record", declaration: "type CallResult[T any] struct {\n\tvalue    T\n\tok       bool\n\ttimedOut bool\n\treason   string\n}"}
	case "Delivery":
		return NativeDeclaration{name: "Delivery", kind: "record", declaration: "type Delivery[T any] struct {\n\tvalue T\n\tok    bool\n}"}
	case "List":
		return NativeDeclaration{name: "List", kind: "collection", declaration: "List[T]"}
	case "Map":
		return NativeDeclaration{name: "Map", kind: "collection", declaration: "Map[K, V]"}
	case "call":
		return NativeDeclaration{name: "call", kind: "function", declaration: "func call[R, Q any](pid Pid, request Q, timeout int) CallResult[R]"}
	case "get":
		return NativeDeclaration{name: "get", kind: "function", declaration: "func get[K comparable, V any](items Map[K, V], key K) Delivery[V]"}
	case "head":
		return NativeDeclaration{name: "head", kind: "function", declaration: "func head[T any](items List[T]) Delivery[T]"}
	case "prepend":
		return NativeDeclaration{name: "prepend", kind: "function", declaration: "func prepend[T any](value T, items List[T]) List[T]"}
	case "put":
		return NativeDeclaration{name: "put", kind: "function", declaration: "func put[K comparable, V any](items Map[K, V], key K, value V) Map[K, V]"}
	case "receive":
		return NativeDeclaration{name: "receive", kind: "function", declaration: "func receive[T any](timeout int) Delivery[T]"}
	case "remove":
		return NativeDeclaration{name: "remove", kind: "function", declaration: "func remove[K comparable, V any](items Map[K, V], key K) Map[K, V]"}
	case "send":
		return NativeDeclaration{name: "send", kind: "function", declaration: "func send[T any](pid Pid, value T)"}
	case "sendAfter":
		return NativeDeclaration{name: "sendAfter", kind: "function", declaration: "func sendAfter[T any](pid Pid, value T, delayMillis int) Timer"}
	case "spawn":
		return NativeDeclaration{name: "spawn", kind: "function", declaration: "func spawn[T any](worker func(T), args T) Pid"}
	case "spawnMonitor":
		return NativeDeclaration{name: "spawnMonitor", kind: "function", declaration: "func spawnMonitor[T any](worker func(T), args T) Process"}
	case "supervise":
		return NativeDeclaration{name: "supervise", kind: "function", declaration: "func supervise[T any](supervisor Supervisor, name string, worker func(T), args T, options ChildOptions) Child"}
	case "superviseServer":
		return NativeDeclaration{name: "superviseServer", kind: "function", declaration: "func superviseServer[S, Q, R any](supervisor Supervisor, name string, handler func(*S, Q) R, initial S, options ChildOptions) Child"}
	case "tail":
		return NativeDeclaration{name: "tail", kind: "function", declaration: "func tail[T any](items List[T]) List[T]"}
	}
	return NativeDeclaration{}
}
