	switch name {
	case "assert":
		return "condition"
	case "buildProgram":
		return "source path inputs stress stats"
	case "byteAt":
		return "text index"
	case "cancelTimer":
		return "timer"
	case "canonicalPath":
		return "path"
	case "demonitor":
		return "watcher"
	case "formatInt":
		return "value"
	case "isDigit":
		return "value"
	case "isLetter":
		return "value"
	case "join":
		return "parts separator"
	case "lookupChild":
		return "supervisor name"
	case "makeDirectories":
		return "path"
	case "moduleFiles":
		return "path"
	case "modulePath":
		return "file relative"
	case "monitor":
		return "pid"
	case "parseInt":
		return "text"
	case "pathInfo":
		return "path"
	case "readDirectory":
		return "path"
	case "readFile":
		return "path"
	case "removeChild":
		return "supervisor name"
	case "replaceFile":
		return "path expected text"
	case "restartChild":
		return "supervisor name"
	case "runProgram":
		return "source arguments stress stats"
	case "runTestProgram":
		return "source arguments stress stats timeout"
	case "runTestProgramResult":
		return "source arguments stress stats timeout stderrOutput"
	case "runeAt":
		return "text offset"
	case "sha256":
		return "text"
	case "slice":
		return "text start end"
	case "sourceFiles":
		return "paths"
	case "split":
		return "text separator"
	case "sqliteQuery":
		return "path sql params timeout"
	case "startSupervisor":
		return "maxRestarts withinSeconds"
	case "stopChild":
		return "supervisor name"
	case "stopSupervisor":
		return "supervisor"
	case "supervisorPid":
		return "supervisor"
	case "tcpAccept":
		return "socket timeout"
	case "tcpClose":
		return "socket"
	case "tcpConnect":
		return "host port timeout"
	case "tcpListen":
		return "host port"
