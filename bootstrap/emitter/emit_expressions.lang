package main

func emitOperator(operator string) string {
	switch operator {
	case "+":
		return "add"
	case "-":
		return "sub"
	case "*":
		return "mul"
	case "/":
		return "divide"
	case "%":
		return "remain"
	case "&":
		return "bit_and"
	case "|":
		return "bit_or"
	case "^":
		return "bit_xor"
	case "&^":
		return "bit_clear"
	case "<<":
		return "shift_left"
	case ">>":
		return "shift_right"
	case "==":
		return "eq"
	case "!=":
		return "ne"
	case "<":
		return "lt"
	case "<=":
		return "le"
	case ">":
		return "gt"
	case ">=":
		return "ge"
	}
	return ""
}

func emitConstant(e *Emitter, node SyntaxNode, value ConstantValue) string {
	switch value.kind {
	case "int":
		if integerBits(value.integer) > 64 {
			emitFail(e, node.at, "constant does not fit a runtime integer")
			return ""
		}
		// Decimal printing also supports unsigned constants in shift counts.
		remaining := value.integer
		remaining.negative = false
		text := ""
		for head(remaining.digits).ok {
			division := integerDivide(remaining, integerSmall(10))
			text = formatInt(integerToInt(division.remainder)) + text
			remaining = division.quotient
		}
		if text == "" {
			text = "0"
		}
		if value.integer.negative {
			text = "-" + text
		}
		return text
	case "bool":
		if value.boolean {
			return "true"
		}
		return "false"
	case "string":
		if constantStringLength(value) > 1048576 {
			emitFail(e, node.at, "bootstrap emitter string literal exceeds 1 MiB")
			return ""
		}
		return emitBinaryString(constantStringBytes(value))
	}
	emitFail(e, node.at, "unsupported constant")
	return ""
}

// Every operand is evaluated once, in source order. Only values whose static
// type can contain managed handles need temporary roots.
func emitOrdered(e *Emitter, codes List[string], ids List[int], target string) string {
	var setup List[string]
	var values List[string]
	for _, code := range codes {
		value := emitFresh(e)
		setup = append(setup, value+" = "+emitKeep(e, head(ids).value, code))
		ids = tail(ids)
		values = append(values, value)
	}
	if len(target) >= 4 && slice(target, 0, 4) == "fun(" {
		target = "(" + target + ")"
	}
	setup = append(setup, target+"("+join(values, ", ")+")")
	return "(begin " + join(setup, ", ") + " end)"
}

func emitShiftCount(e *Emitter, node SyntaxNode) string {
	value := emitValue(e, node)
	unsigned := untypedInteger(value.typeID)
	code := emitExpression(e, node, unsigned)
	if unsigned {
		return "((" + code + ") band 18446744073709551615)"
	}
	return code
}

func emitExpression(e *Emitter, node SyntaxNode, unsigned bool) string {
	if e.reason != "" {
		return ""
	}
	e.depth++
	if e.depth > 128 {
		emitFail(e, node.at, "bootstrap emission nesting exceeds 128 levels")
		e.depth--
		return ""
	}
	code := emitExpressionInner(e, node, unsigned)
	e.depth--
	return code
}

func emitExpressionInner(e *Emitter, node SyntaxNode, unsigned bool) string {
	value := emitValue(e, node)
	if value.constant.kind != "" {
		return emitConstant(e, node, value.constant)
	}
	// A typed expression keeps its own context even inside an unsigned count.
	unsigned = unsigned && untypedInteger(value.typeID)
	switch node.kind {
	case "ParenExpr":
		return emitExpression(e, childAt(node, 0), unsigned)
	case "Ident":
		if value.typeID == tNil {
			return "nil"
		}
		return emitReadLocal(e, node)
	case "StarExpr":
		return "linglang_rt:read(" + emitExpression(e, childAt(node, 0), false) + ")"
	case "SelectorExpr":
		return "linglang_rt:field_value(" + emitExpression(e, childAt(node, 0), false) + ", " + emitFieldName(childAt(node, 1).text) + ")"
	case "CompositeLit":
		kind := get(e.checked.types, value.typeID).value.kind
		if kind == "list" || kind == "map" {
			return emitCollection(e, node, value.typeID)
		}
		return emitStruct(e, node, value.typeID)
	case "UnaryExpr":
		if node.text == "&" {
			return emitAddress(e, childAt(node, 0))
		}
		x := emitExpression(e, childAt(node, 0), unsigned)
		switch node.text {
		case "+":
			return x
		case "-":
			return "linglang_rt:binary(sub, 0, " + x + ")"
		case "^":
			return "linglang_rt:binary(bit_xor, " + x + ", -1)"
		case "!":
			return "(not (" + x + "))"
		}
	case "BinaryExpr":
		left := emitExpression(e, childAt(node, 0), unsigned)
		right := ""
		if node.text == "<<" || node.text == ">>" {
			right = emitShiftCount(e, childAt(node, 1))
		} else {
			right = emitExpression(e, childAt(node, 1), unsigned)
		}
		if node.text == "&&" {
			return "((" + left + ") andalso (" + right + "))"
		}
		if node.text == "||" {
			return "((" + left + ") orelse (" + right + "))"
		}
		op := emitOperator(node.text)
		if unsigned && (node.text == "/" || node.text == "%" || node.text == ">>") {
			op += "_unsigned"
		}
		return emitOrdered(e, List[string]{left, right}, List[int]{emitValue(e, childAt(node, 0)).typeID, emitValue(e, childAt(node, 1)).typeID}, "fun(A, B) -> linglang_rt:binary("+op+", A, B) end")
	case "CallExpr":
		return emitCall(e, node)
	}
	emitFail(e, node.at, "bootstrap emitter does not support expression "+node.kind)
	return ""
}

func emitCallee(node SyntaxNode) SyntaxNode {
	for node.kind == "ParenExpr" || node.kind == "IndexExpr" || node.kind == "IndexListExpr" {
		node = childAt(node, 0)
	}
	return node
}

func emitCall(e *Emitter, node SyntaxNode) string {
	callee := emitCallee(childAt(node, 0))
	if callee.kind != "Ident" {
		emitFail(e, node.at, "bootstrap emitter supports only direct non-variadic calls")
		return ""
	}
	function := emitValue(e, callee)
	if function.kind == "intrinsic" && emitProcessIntrinsic(function.name) {
		return emitProcessCall(e, node, function.name)
	}
	collection := function.kind == "intrinsic" && (function.name == "prepend" || function.name == "head" || function.name == "tail" || function.name == "get" || function.name == "put" || function.name == "remove")
	if (childAt(node, 0).kind != "Ident" && !collection && function.kind != "native") || (node.text != "" && !(function.kind == "intrinsic" && function.name == "append")) {
		emitFail(e, node.at, "bootstrap emitter requires a supported direct call")
		return ""
	}
	var codes List[string]
	ids := emitArgumentTypes(e, node)
	for _, argument := range tail(node.children) {
		codes = append(codes, emitExpression(e, argument, false))
	}
	if function.kind == "type" {
		if function.typeID == tInt || function.typeID == tBool || function.typeID == tString && emitValue(e, childAt(node, 1)).typeID == tString {
			return head(codes).value
		}
		emitFail(e, node.at, "bootstrap emitter does not support this runtime conversion")
		return ""
	}
	if function.kind == "func" {
		return emitOrdered(e, codes, ids, emitFunctionName(callee.text))
	}
	if collection {
		return emitCollectionCall(e, node, function.name, codes, ids)
	}
	if function.kind == "intrinsic" {
		switch function.name {
		case "print", "println":
			newline := "false"
			if function.name == "println" {
				newline = "true"
			}
			// Operand names are gathered separately because print accepts a list.
			var setup List[string]
			var values List[string]
			for _, code := range codes {
				name := emitFresh(e)
				setup = append(setup, name+" = "+emitKeep(e, head(ids).value, code))
				ids = tail(ids)
				values = append(values, name)
			}
			setup = append(setup, "linglang_rt:print(["+join(values, ", ")+"], "+newline+")")
			return "(begin " + join(setup, ", ") + " end)"
		case "panic":
			if defaultType(emitValue(e, childAt(node, 1)).typeID) != tString {
				emitFail(e, node.at, "panic requires a string reason")
			}
			return "erlang:error({linglang_panic, " + head(codes).value + "})"
		case "append":
			return emitAppend(e, node, codes, ids)
		case "len":
			if defaultType(emitValue(e, childAt(node, 1)).typeID) == tString {
				return emitOrdered(e, codes, ids, "byte_size")
			}
			kind := get(e.checked.types, emitValue(e, childAt(node, 1)).typeID).value.kind
			if kind == "list" || kind == "map" {
				return emitOrdered(e, codes, ids, "linglang_rt:"+kind+"_length")
			}
		}
	}
	if function.kind == "native" {
		target := ""
		switch function.name {
		case "self":
			target = "self"
		case "monitor":
			target = "linglang_rt:monitor_process"
		case "wait":
			target = "linglang_rt:wait_process"
		case "demonitor":
			target = "linglang_rt:demonitor_process"
		case "cancelTimer":
			target = "linglang_rt:cancel_timer"
		case "startSupervisor":
			target = "linglang_sup:start"
		case "supervisorPid":
			target = "linglang_sup:pid"
		case "lookupChild":
			target = "linglang_sup:lookup"
		case "restartChild":
			target = "linglang_sup:restart"
		case "stopChild":
			target = "linglang_sup:stop_child"
		case "removeChild":
			target = "linglang_sup:remove_child"
		case "stopSupervisor":
			target = "linglang_sup:stop"
		case "args":
			target = "linglang_rt:arguments"
		case "readFile":
			target = "linglang_rt:read_file"
		case "writeFile":
			target = "linglang_rt:write_file"
		case "tcpListen":
			target = "linglang_io:tcp_listen"
		case "tcpConnect":
			target = "linglang_io:tcp_connect"
		case "tcpAccept":
			target = "linglang_io:tcp_accept"
		case "tcpPort":
			target = "linglang_io:tcp_port"
		case "tcpRead":
			target = "linglang_io:tcp_read"
		case "tcpWrite":
			target = "linglang_io:tcp_write"
		case "tcpClose":
			target = "linglang_io:tcp_close"
		case "sqliteQuery":
			target = "linglang_io:sqlite_query"
		case "sha256":
			target = "linglang_io:sha256"
		case "pathInfo":
			target = "linglang_io:path_info"
		case "readDirectory":
			target = "linglang_io:read_directory"
		case "canonicalPath":
			target = "linglang_io:canonical_path"
		case "makeDirectories":
			target = "linglang_io:make_directories"
		case "writeNewFile":
			target = "linglang_io:write_new_file"
		case "replaceFile":
			target = "linglang_io:replace_file"
		case "monotonicMillis":
			target = "linglang_rt:monotonic_millis"
		case "modulePath":
			target = "linglang_rt:module_path"
		case "testFiles":
			target = "linglang_rt:test_files"
		case "toolReport":
			target = "linglang_rt:tool_report"
		case "runTestProgramResult":
			target = "linglang_rt:run_test_program_result"
		case "runTestProgram":
			target = "linglang_rt:run_test_program"
		case "moduleFiles":
			target = "linglang_rt:module_files"
		case "sourceFiles":
			target = "linglang_rt:source_files"
		case "buildProgram":
			target = "linglang_rt:build_program"
		case "runProgram":
			target = "linglang_rt:run_program"
		case "runeAt":
			target = "linglang_rt:text_rune"
		case "join":
			target = "linglang_rt:text_join"
		case "split":
			target = "linglang_rt:text_split"
		case "formatInt":
			target = "linglang_rt:format_int"
		case "parseInt":
			target = "linglang_rt:parse_int"
		case "trim":
			target = "linglang_rt:text_trim"
		case "byteAt":
			target = "linglang_rt:text_byte"
		case "slice":
			target = "linglang_rt:text_slice"
		case "isLetter":
			target = "linglang_rt:unicode_letter"
		case "isDigit":
			target = "linglang_rt:unicode_digit"
		case "assert":
			codes = append(codes, emitBinaryString(node.at.filename))
			codes = append(codes, formatInt(node.at.line))
			ids = append(append(ids, tString), tInt)
			target = "linglang_rt:assert_value"
		}
		if target != "" {
			return emitOrdered(e, codes, ids, target)
		}
	}
	emitFail(e, node.at, "bootstrap emitter does not support call "+callee.text)
	return ""
}
