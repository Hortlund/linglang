package main

func TestBootstrapOptions() {
	legacy := bootstrapOptions(List[string]{"main.lang"})
	assert(legacy.command == "emit" && head(legacy.paths).value == "main.lang")
	assert(bootstrapOptions(List[string]{"--help"}).help)
	built := bootstrapOptions(List[string]{"build", "--gc-stress", "--gc-stats", "-o", "snow bean", "source"})
	assert(built.command == "build" && built.output == "snow bean" && built.stress && built.stats)
	assert(len(built.paths) == 1 && head(built.paths).value == "source")
	ran := bootstrapOptions(List[string]{"run", "source", "--", "", "-flag", "snow 雪"})
	assert(ran.command == "run" && len(ran.arguments) == 3)
	assert(head(ran.arguments).value == "" && head(tail(ran.arguments)).value == "-flag")
	assert(!ran.noOpt && bootstrapOptions(List[string]{"emit", "--no-opt", "main.lang"}).noOpt)
	forwarded := bootstrapOptions(List[string]{"run", "main.lang", "--", "--no-opt"})
	assert(!forwarded.noOpt && head(forwarded.arguments).value == "--no-opt")
}

func TestEmitterNativeLocals() {
	parsed := parse("locals.lang", "package main\nfunc f(n int,s string,b bool)int{n++;x:=n;x*=2;s+=\"!\";b=!b;println(s,b);return x};func main(){println(f(3,\"ok\",true))}")
	optimized := emitPackage(List[SyntaxNode]{parsed.root})
	cells := emitPackageWithOptions(List[SyntaxNode]{parsed.root}, true)
	assert(parsed.ok && optimized.ok && cells.ok)
	// A wholly primitive straight-line program needs no managed cells.
	assert(len(split(optimized.module, "linglang_rt:new(")) == 1)
	assert(len(split(cells.module, "linglang_rt:new(")) > 1)
	for _, source := range (List[string]{
		"func f(n int)*int{return &n};func main(){println(*f(3))}",
		"func f(n int)int{for n<3{n++};return n};func main(){println(f(0))}",
		"func main(){x:=1;if true{p:=&x;(*p)++};println(x)}",
	}) {
		parsed = parse("boxed.lang", "package main\n"+source)
		optimized = emitPackage(List[SyntaxNode]{parsed.root})
		assert(parsed.ok && optimized.ok && len(split(optimized.module, "linglang_rt:new(")) > 1)
	}
}

func TestEmitterReadOnlyLocals() {
	for _, source := range (List[string]{
		"func main(){x:=1;{x:=2;println(x)};if x==1{x:=3;println(x)}else{x:=4;println(x)};println(x)}",
		"func main(){var x int;var s string=\"yes\";b:=true;if b{println(x,s)};switch n:=2;n{case 2:y:=n+1;println(y);default:y:=0;println(y)}}",
		"func main(){for n:=7;n==7;{x:=n+1;println(x);break}}",
	}) {
		parsed := parse("readonly.lang", "package main\n"+source)
		optimized := emitPackage(List[SyntaxNode]{parsed.root})
		cells := emitPackageWithOptions(List[SyntaxNode]{parsed.root}, true)
		assert(parsed.ok && optimized.ok && cells.ok)
		assert(len(split(optimized.module, "linglang_rt:new(")) == 1)
		assert(len(split(cells.module, "linglang_rt:new(")) > 1)
	}
	parsed := parse("range.lang", "package main\nfunc main(){for i,n:=range (List[int]{1,2}){x:=i+n;println(x)}}")
	optimized := emitPackage(List[SyntaxNode]{parsed.root})
	assert(parsed.ok && optimized.ok)
	// The cursor, index and read-only iteration bindings all stay native.
	assert(len(split(optimized.module, "linglang_rt:new(")) == 1)
	assert(len(split(optimized.module, "linglang_rt:list_range(")) == 2)
	cells := emitPackageWithOptions(List[SyntaxNode]{parsed.root}, true)
	assert(cells.ok && len(split(cells.module, "linglang_rt:list_range(")) == 1)
}

func TestCheckedMetadata() {
	parsed := parse("metadata.lang", "package main\nfunc add(n int)int{x:=n+1+2+3;return x};func main(){println(add(4))}")
	assert(parsed.ok)
	var seen Map[int, bool]
	pending := List[SyntaxNode]{parsed.root}
	for head(pending).ok {
		node := head(pending).value
		pending = tail(pending)
		if node.kind != "nil" {
			assert(node.id > 0 && !get(seen, node.id).ok)
			seen = put(seen, node.id, true)
		}
		for _, child := range node.children {
			pending = prepend(child, pending)
		}
	}
	checked := checkPackageInfo(List[SyntaxNode]{parsed.root}, true)
	assert(checked.ok && len(checked.expressions) > 0 && len(checked.definitions) == 4)
	function := head(tail(parsed.root.children)).value
	declaration := head(childAt(function, 3).children).value
	expression := head(childAt(declaration, 1).children).value
	outer := get(checked.expressions, expressionIdentity(expression))
	inner := get(checked.expressions, expressionIdentity(childAt(expression, 0)))
	assert(outer.ok && inner.ok && outer.value.typeID == tInt && inner.value.typeID == tInt)
}

func TestEmitterBoundaries() {
	for _, source := range (List[string]{
		"func main(){for range (Map[int,int]{1:2}) {}}",
		"func main(){n:=30;println('a'<<n)}",
		"func main(){n:=30;println('a'>>n)}",
		"func main(){n:=30;println(('a'<<n)==0)}",
		"func main(){n:=30;println(('a'<<n)<0)}",
		"func main(){n:=30;println(^('a'<<n))}",
		"func main(){n:=30;println(-('a'<<n))}",
		"func main(){n:=30;println(('a'<<n)+1)}",
		"func main(){n:=30;_ = 'a'<<n}",
		"func main(){n:=30;panic('a'<<n)}",
		"type N struct{x Map[string,int]};func main(){println(new(N))}",
		"type N struct{x int};func main(){println(new(N))}",
		"type N struct{x int};func main(){println(N{1})}",
		"func f(n int)int{if n>0{return 1}};func main(){}",
		"func f()int{for{break}};func main(){}",
		"func f()int{for true{return 1}};func main(){}",
		"func main(){panic(1)}",
		"func main(){send(self(),monitor(self()))}",
		"func main(){x,y:=1,2;println(x,y)}",
		"func f()int{switch{case true:return 1}};func main(){}",
		"func f()int{switch{default:break;return 1}};func main(){}",
		"func main(){break}",
		"func main(){switch{default:continue}}",
		"func main(){println(List[int]{1:2})}",
		"func main(){println(List[*int]{{}})}",
	}) {
		parsed := parse("unsupported.lang", "package main\n"+source)
		assert(parsed.ok)
		result := emitPackage(List[SyntaxNode]{parsed.root})
		assert(!result.ok && result.module == "" && result.reason != "" && result.at.filename == "unsupported.lang")
	}
}

func TestEmitterLoops() {
	for _, source := range (List[string]{
		"func main(){for{break}}",
		"func main(){n:=0;for n<2{n++;continue};for i:=0;i<2;i++{println(i)}}",
		"func f()int{for{return 42}};func main(){println(f())}",
		"func f()int{for{for{break};return 42}};func main(){println(f())}",
	}) {
		parsed := parse("loops.lang", "package main\n"+source)
		assert(parsed.ok)
		result := emitPackage(List[SyntaxNode]{parsed.root})
		assert(result.ok && result.reason == "" && (len(split(result.module, "linglang_rt:loop(")) > 1 || len(split(result.module, "linglang_rt:loop_cell(")) > 1))
	}
}

