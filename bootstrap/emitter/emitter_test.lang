func TestEmitterLeafScopes() {
	for _, source := range (List[string]{
		"func f(p *int){(*p)++};func main(){}",
		"type N struct{x int;next *N};func f(p *N,q *N){p.next=q;p.x+=2};func main(){}",
		"func f(p *int,q *int)*int{*p,*q=*q,*p;(*p)++;return q};func main(){}",
		"func f(p *int)int{if n:=*p;n>0{x:=n+1;return x};{x:=2;*p+=x};return *p};func main(){}",
		"func f(p *int){if *p<0{panic(\"negative\")};assert(*p>=0)};func main(){}",
	}) {
		parsed := parse("leaf.lang", "package main\n"+source)
		optimized := emitPackage(List[SyntaxNode]{parsed.root})
		cells := emitPackageWithOptions(List[SyntaxNode]{parsed.root}, true)
		assert(parsed.ok && optimized.ok && cells.ok)
		for _, operation := range (List[string]{"linglang_rt:scope(", "linglang_rt:keep(", "linglang_rt:safepoint(", "linglang_rt:new("}) {
			assert(len(split(optimized.module, operation)) == 1)
			if operation != "linglang_rt:keep(" {
				assert(len(split(cells.module, operation)) > 1)
			}
		}
	}
	for _, source := range (List[string]{
		"func f(p *int){for i:=0;i<2;i++{(*p)++}};func main(){}",
		"func f(p *int){if false{_= &p}};func main(){}",
		"func f(p *int){q:=p;_=q};func main(){}",
		"func f(p *int){p=nil};func main(){}",
		"func f(p *int){switch *p{case 0:(*p)++}};func main(){}",
		"func f(p *int){for _,n:=range (List[int]{1}){*p+=n}};func main(){}",
		"func f(p *int){_=receive[int](0);(*p)++};func main(){}",
		"func f(p *int){println(*p)};func main(){}",
		"func len(n int)int{_= &n;return n};func f(p *int){if false{_=len(*p)}};func main(){}",
		"func alloc(){n:=1;_= &n};func f(p *int){if false{alloc()};(*p)++};func main(){}",
	}) {
		parsed := parse("rooted.lang", "package main\n"+source)
		result := emitPackage(List[SyntaxNode]{parsed.root})
		assert(parsed.ok && result.ok)
		function := head(split(head(tail(split(result.module, "\nf_66("))).value, "\n\n")).value
		assert(len(split(function, "linglang_rt:scope(")) > 1)
	}
}

func TestEmitterMixedFlow() {
	for _, source := range (List[string]{
		"func f(Map[bool,int]){for{break}};func main(){}",
		"func f(_ Map[bool,int]){for{break}};func main(){}",
	}) {
		parsed := parse("parameter-type.lang", "package main\n"+source)
		assert(parsed.ok)
		assert(!emitPackage(List[SyntaxNode]{parsed.root}).ok)
		assert(!emitPackageWithOptions(List[SyntaxNode]{parsed.root}, true).ok)
	}
	for _, source := range (List[string]{
		"type N struct{x int};func use(p *N){};func main(){n:=N{};for i:=0;i<3;i++{use(&n)}}",
		"type N struct{x int};func main(){p:= &N{x:1};for i:=0;i<3;i++{assert(p.x==1)}}",
		"func main(){x:=0;for x<2{x++;if false{println(&x)}}}",
		"func main(){var m Map[int,int];for i:=0;i<3;i++{m=put(m,i,i)};assert(len(m)==3)}",
	}) {
		parsed := parse("mixed.lang", "package main\n"+source)
		optimized := emitPackage(List[SyntaxNode]{parsed.root})
		cells := emitPackageWithOptions(List[SyntaxNode]{parsed.root}, true)
		assert(parsed.ok && optimized.ok && cells.ok)
		assert(len(split(optimized.module, "_flow_")) > 1)
		assert(len(split(optimized.module, "linglang_rt:roots([")) > 1)
		assert(len(split(optimized.module, "linglang_rt:loop(")) == 1)
		assert(len(split(cells.module, "_flow_")) == 1)
	}
	parsed := parse("counter.lang", "package main;type N struct{x int};func main(){n:=N{};for i:=0;i<3;i++{println(&n)}}")
	optimized := emitPackage(List[SyntaxNode]{parsed.root})
	assert(parsed.ok && optimized.ok)
	assert(len(split(optimized.module, "linglang_rt:new(")) == 2)
	assert(len(split(optimized.module, "linglang_rt:scope(")) == 2)
	// Only address-taking on a for initializer requires fresh iteration cells.
	parsed = parse("iteration.lang", "package main;func main(){for i:=0;i<3;i++{println(&i)}}")
	optimized = emitPackage(List[SyntaxNode]{parsed.root})
	assert(parsed.ok && optimized.ok && len(split(optimized.module, "_flow_")) == 1)
}
