func TestEmitterFileOrder() {
	a := parse("a:\"雪\n.lang", "package main\nfunc answer()*Box{return &Box{value:42}}")
	b := parse("a:\"雪\n.lang:1", "package main\ntype Box struct{value int};func main(){println(answer().value)}")
	first := emitPackage(List[SyntaxNode]{a.root, b.root})
	second := emitPackage(List[SyntaxNode]{b.root, a.root})
	assert(first.ok && second.ok && first.module == second.module)
	assert(!emitPackage(List[SyntaxNode]{a.root, a.root}).ok)
}

