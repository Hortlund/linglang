func TestMapKeyBindings() {
	parsed := parse("keys.lang", "package main\ntype S struct{key int};func f(key string)Map[string,int]{return Map[string,int]{key:7}};func main(){key:=2;s:=S{key:3};_=s;{key:=4;_=Map[int,int]{key:5}};_=Map[int,int]{key:6}}")
	assert(parsed.ok)
	checked := checkPackageInfo(List[SyntaxNode]{parsed.root}, true)
	assert(checked.ok)
	var deferred Map[string, bool]
	for _, at := range checked.bindings.deferred {
		deferred = put(deferred, sourceIdentity(at), true)
	}
	// Independently walk the parsed AST to distinguish field and Map keys, then
	// verify that only runtime Map keys become references to their declarations.
	pending := List[SyntaxNode]{parsed.root}
	count := 0
	fields := 0
	for head(pending).ok {
		node := head(pending).value
		pending = tail(pending)
		if node.kind == "CompositeLit" {
			kind := get(checked.types, get(checked.expressions, expressionIdentity(node)).value.typeID).value.kind
			for _, element := range tail(node.children) {
				key := childAt(element, 0)
				if key.kind == "Ident" {
					found := false
					for _, reference := range checked.bindings.references {
						if sourceIdentity(reference.at) == sourceIdentity(key.at) {
							assert(kind == "map" && reference.symbol.name == key.text)
							assert(get(checked.definitions, sourceIdentity(reference.symbol.at)).ok)
							assert(reference.symbol.at.offset < key.at.offset)
							found = true
						}
					}
					if kind == "map" {
						assert(found && !get(deferred, sourceIdentity(key.at)).ok)
						count++
					} else {
						assert(!found && get(deferred, sourceIdentity(key.at)).ok)
						fields++
					}
				}
			}
		}
		for _, child := range node.children {
			pending = prepend(child, pending)
		}
	}
	assert(count == 3 && fields == 1)
	assert(emitPackage(List[SyntaxNode]{parsed.root}).ok)
}

// Recursive pointer-free containers remain values, while pointers reachable
// through a recursive type graph must be found regardless of cache order.
func TestEmitterReferenceTypes() {
	parsed := parse("roots.lang", "package main\ntype V struct{children List[V];data Map[string,List[V]]};type A struct{bs List[B]};type B struct{as List[A];p *int};func main(){var v V;var a A;var b B;println(v,a,b)}")
	assert(parsed.ok)
	checked := checkPackageInfo(List[SyntaxNode]{parsed.root}, true)
	assert(checked.ok)
	e := Emitter{checked: checked}
	count := 0
	for id := tVoid + 1; id <= len(checked.types); id++ {
		t := get(checked.types, id).value
		if t.name == "V" {
			count++
			assert(!emitReferences(&e, id))
		}
		if t.name == "A" || t.name == "B" {
			count++
			assert(emitReferences(&e, id))
		}
	}
	for id := tVoid + 1; id <= len(checked.types); id++ {
		t := get(checked.types, id).value
		if t.name == "A" || t.name == "B" {
			assert(emitReferences(&e, id))
		}
	}
	assert(count == 3 && emitReferences(&e, tInvalid))
}

