		"func main(){if n:=1;n>0{println(n)}else{println(n)}}",
		"func f()*int{if n:=4;n>0{return &n};return nil};func main(){println(*f())}",
		"func main(){x:=9;if x:=1;x>2{println(x)}else if y:=x+1;y==2{println(x,y)};println(x)}",
