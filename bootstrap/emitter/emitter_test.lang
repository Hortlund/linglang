package main

func TestCheckedMetadata() {
	parsed := parse("metadata.lang", "package main\nfunc add(n int)int{x:=n+1+2+3;return x};func main(){println(add(4))}")
	assert(parsed.ok)
	var seen Map[int, bool]
	pending := List[SyntaxNode]{parsed.root}
	for head(pending).ok {
		node := head(pending).value
		pending = tail(pending)
		if node.kind != "nil" {
			assert(node.id > 0 && !get(seen, node.id).ok)
			seen = put(seen, node.id, true)
		}
		for _, child := range node.children {
			pending = prepend(child, pending)
		}
	}
	checked := checkPackageInfo(List[SyntaxNode]{parsed.root}, true)
	assert(checked.ok && len(checked.expressions) > 0 && len(checked.definitions) == 4)
	function := head(tail(parsed.root.children)).value
	declaration := head(childAt(function, 3).children).value
	expression := head(childAt(declaration, 1).children).value
	outer := get(checked.expressions, expressionIdentity(expression))
	inner := get(checked.expressions, expressionIdentity(childAt(expression, 0)))
	assert(outer.ok && inner.ok && outer.value.typeID == tInt && inner.value.typeID == tInt)
}

func TestEmitterBoundaries() {
	for _, source := range (List[string]{
		"func main(){for range (Map[int,int]{1:2}) {}}",
		"func main(){n:=30;println('a'<<n)}",
		"func main(){n:=30;println('a'>>n)}",
		"func main(){n:=30;println(('a'<<n)==0)}",
		"func main(){n:=30;println(('a'<<n)<0)}",
		"func main(){n:=30;println(^('a'<<n))}",
		"func main(){n:=30;println(-('a'<<n))}",
		"func main(){n:=30;println(('a'<<n)+1)}",
		"func main(){n:=30;_ = 'a'<<n}",
		"func main(){n:=30;panic('a'<<n)}",

		"func main(){if x:=1;x>0{println(x)}}",
		"type N struct{x Map[string,int]};func main(){println(new(N))}",
		"type N struct{x int};func main(){println(new(N))}",
		"type N struct{x int};func main(){println(N{1})}",
		"func f(n int)int{if n>0{return 1}};func main(){}",
		"func f()int{for{break}};func main(){}",
		"func f()int{for true{return 1}};func main(){}",
		"func main(){panic(1)}",
		"func main(){startSupervisor(1,100)}",
		"func main(){x,y:=1,2;println(x,y)}",
		"func f()int{switch{case true:return 1}};func main(){}",
		"func f()int{switch{default:break;return 1}};func main(){}",
		"func main(){break}",
		"func main(){switch{default:continue}}",
		"func main(){println(List[int]{1:2})}",
		"func main(){println(List[*int]{{}})}",
	}) {
		parsed := parse("unsupported.lang", "package main\n"+source)
		assert(parsed.ok)
		result := emitPackage(List[SyntaxNode]{parsed.root})
		assert(!result.ok && result.module == "" && result.reason != "" && result.at.filename == "unsupported.lang")
	}
}

func TestEmitterLoops() {
	for _, source := range (List[string]{
		"func main(){for{break}}",
		"func main(){n:=0;for n<2{n++;continue};for i:=0;i<2;i++{println(i)}}",
		"func f()int{for{return 42}};func main(){println(f())}",
		"func f()int{for{for{break};return 42}};func main(){println(f())}",
	}) {
		parsed := parse("loops.lang", "package main\n"+source)
		assert(parsed.ok)
		result := emitPackage(List[SyntaxNode]{parsed.root})
		assert(result.ok && result.reason == "" && (len(split(result.module, "linglang_rt:loop(")) > 1 || len(split(result.module, "linglang_rt:loop_cell(")) > 1))
	}
}

func TestEmitterSwitches() {
	for _, source := range (List[string]{
		"func main(){switch n:=2;n{default:println(0);case 1,2:println(n);break}}",
		"func f(n int)int{switch n{case 1:return 2;default:return 3}};func main(){println(f(1))}",
		"func f()int{for{switch{default:break};return 1}};func main(){println(f())}",
		"func main(){for i:=0;i<2;i++{switch i{case 0:continue;default:for{break};break};println(i)}}",
		"func main(){switch{};switch{default:};println(len(args()),readFile(\"missing\").ok,runeAt(\"雪\",0).width)}",
	}) {
		parsed := parse("switches.lang", "package main\n"+source)
		assert(parsed.ok)
		result := emitPackage(List[SyntaxNode]{parsed.root})
		assert(result.ok && result.reason == "" && len(result.module) > 0)
	}
}

func TestEmitterReferences() {
	for _, source := range (List[string]{
		"type N struct{x int;next *N};func main(){n:=N{x:1};n.next=&n;println(n.next.x)}",
		"type N struct{x int};func f(n int)*N{return &N{x:n}};func main(){p:=f(3);p.x++;println(*p)}",
		"func main(){x:=1;p:=&x;q:=&p;**q+=2;println(x)}",
		"type N struct{x int};func main(){var n N;p:=&N{};p.x=2;println(n.x,p.x)}",
	}) {
		parsed := parse("references.lang", "package main\n"+source)
		assert(parsed.ok)
		result := emitPackage(List[SyntaxNode]{parsed.root})
		assert(result.ok && result.reason == "" && len(result.module) > 0)
	}
}

func TestEmitterFileOrder() {
	a := parse("a:\"雪\n.lang", "package main\nfunc answer()*Box{return &Box{value:42}}")
	b := parse("a:\"雪\n.lang:1", "package main\ntype Box struct{value int};func main(){println(answer().value)}")
	first := emitPackage(List[SyntaxNode]{a.root, b.root})
	second := emitPackage(List[SyntaxNode]{b.root, a.root})
	assert(first.ok && second.ok && first.module == second.module)
	assert(!emitPackage(List[SyntaxNode]{a.root, a.root}).ok)
}

func TestEmitterCollections() {
	for _, source := range (List[string]{
		"type N struct{xs List[N];m Map[string,*N]};func main(){var n N;println(len(n.xs),len(n.m));xs:=List[int]{1,2};for i,v:=range xs{println(i,v)};println(head(xs).value)}",
		"func main(){var d Delivery[bool];xs:=append(List[bool]{},true);xs=append(xs,List[bool]{false}...);println(d.value,d.ok,head(xs).value);m:=put(nil,1,xs);println(head(get(m,1).value).ok)}",
		"func main(){println((head[int])(nil).ok,(get[string,int])(nil,\"x\").value,join(split(\"a,b\",\",\"),\"-\"))}",
	}) {
		parsed := parse("collections.lang", "package main\n"+source)
		assert(parsed.ok)
		result := emitPackage(List[SyntaxNode]{parsed.root})
		assert(result.ok && result.reason == "" && len(result.module) > 0)
	}
}

func TestRangeBindings() {
	parsed := parse("range.lang", "package main\nfunc main(){for i,v:=range (List[int]{1}){println(i,v)}}")
	checked := checkPackageInfo(List[SyntaxNode]{parsed.root}, true)
	assert(parsed.ok && checked.ok && len(checked.definitions) == 3)
	loop := head(childAt(head(tail(parsed.root.children)).value, 3).children).value
	assert(get(checked.definitions, sourceIdentity(childAt(loop, 0).at)).value.typeID == tInt)
	assert(get(checked.definitions, sourceIdentity(childAt(loop, 1).at)).value.typeID == tInt)
}

func TestMapKeyBindings() {
	parsed := parse("keys.lang", "package main\ntype S struct{key int};func f(key string)Map[string,int]{return Map[string,int]{key:7}};func main(){key:=2;s:=S{key:3};_=s;{key:=4;_=Map[int,int]{key:5}};_=Map[int,int]{key:6}}")
	assert(parsed.ok)
	checked := checkPackageInfo(List[SyntaxNode]{parsed.root}, true)
	assert(checked.ok)
	var deferred Map[string, bool]
	for _, at := range checked.bindings.deferred {
		deferred = put(deferred, sourceIdentity(at), true)
	}
	// Independently walk the parsed AST to distinguish field and Map keys, then
	// verify that only runtime Map keys become references to their declarations.
	pending := List[SyntaxNode]{parsed.root}
	count := 0
	fields := 0
	for head(pending).ok {
		node := head(pending).value
		pending = tail(pending)
		if node.kind == "CompositeLit" {
			kind := get(checked.types, get(checked.expressions, expressionIdentity(node)).value.typeID).value.kind
			for _, element := range tail(node.children) {
				key := childAt(element, 0)
				if key.kind == "Ident" {
					found := false
					for _, reference := range checked.bindings.references {
						if sourceIdentity(reference.at) == sourceIdentity(key.at) {
							assert(kind == "map" && reference.symbol.name == key.text)
							assert(get(checked.definitions, sourceIdentity(reference.symbol.at)).ok)
							assert(reference.symbol.at.offset < key.at.offset)
							found = true
						}
					}
					if kind == "map" {
						assert(found && !get(deferred, sourceIdentity(key.at)).ok)
						count++
					} else {
						assert(!found && get(deferred, sourceIdentity(key.at)).ok)
						fields++
					}
				}
			}
		}
		for _, child := range node.children {
			pending = prepend(child, pending)
		}
	}
	assert(count == 3 && fields == 1)
	assert(emitPackage(List[SyntaxNode]{parsed.root}).ok)
}
