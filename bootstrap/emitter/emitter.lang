package main

type EmitResult struct {
	ok     bool
	module string
	reason string
	at     Token
}

type Emitter struct {
	checked        CheckResult
	localKeys      Map[string, string]
	cells          Map[string, string]
	valueLocals    Map[string, bool]
	values         Map[string, string]
	straight       bool
	noOpt          bool
	referenceTypes Map[int, bool]
	next           int
	depth          int
	ret            string
	loops          List[string]
	breaks         List[string]
	reason         string
	at             Token
}

func emitFail(e *Emitter, at Token, reason string) {
	if e.reason == "" {
		e.reason = reason
		e.at = at
	}
}

func emitFresh(e *Emitter) string {
	e.next++
	return "_V" + formatInt(e.next)
}

func emitHex(text string) string {
	digits := "0123456789abcdef"
	var reversed List[string]
	for i := 0; i < len(text); i++ {
		b := byteAt(text, i)
		reversed = prepend(slice(digits, b/16, b/16+1)+slice(digits, b%16, b%16+1), reversed)
	}
	var parts List[string]
	for _, part := range reversed {
		parts = prepend(part, parts)
	}
	return join(parts, "")
}

func emitFunctionName(name string) string { return "f_" + emitHex(name) }
func emitScope(code string) string        { return "linglang_rt:scope(fun() -> " + code + " end)" }

func emitBinaryString(text string) string {
	var reversed List[string]
	for i := 0; i < len(text); i++ {
		reversed = prepend(formatInt(byteAt(text, i)), reversed)
	}
	var bytes List[string]
	for _, b := range reversed {
		bytes = prepend(b, bytes)
	}
	return "<<" + join(bytes, ",") + ">>"
}

func emitPrimitive(id int) bool { return id == tInt || id == tBool || id == tString }

func emitDefinition(e *Emitter, node SyntaxNode) CheckedBinding {
	found := get(e.checked.definitions, sourceIdentity(node.at))
	if !found.ok {
		emitFail(e, node.at, "missing checked declaration")
	}
	return found.value
}

func emitValue(e *Emitter, node SyntaxNode) CheckedValue {
	found := get(e.checked.expressions, expressionIdentity(node))
	if !found.ok {
		emitFail(e, node.at, "missing checked expression")
	}
	return found.value
}

func emitCell(e *Emitter, node SyntaxNode, declaration bool) string {
	key := ""
	if declaration {
		key = sourceIdentity(node.at)
	} else {
		key = emitLocalKey(e, node)
		if key == "" {
			emitFail(e, node.at, "bootstrap emitter requires a local variable")
			return ""
		}
	}
	found := get(e.cells, key)
	if found.ok {
		return found.value
	}
	if !declaration {
		emitFail(e, node.at, "variable used before emission of its declaration")
		return ""
	}
	name := emitFresh(e)
	e.cells = put(e.cells, key, name)
	return name
}

func emitPackage(files List[SyntaxNode]) EmitResult {
	return emitPackageWithOptions(files, false)
}

// Retain the original cell lowering as a semantic oracle. Both modes validate
// the same checked AST and preserve lexical managed-root scopes.
func emitPackageWithOptions(files List[SyntaxNode], noOpt bool) EmitResult {
	var sorted List[SyntaxNode]
	var seen Map[string, bool]
	for _, file := range files {
		if get(seen, file.at.filename).ok {
			return EmitResult{reason: "duplicate source file", at: file.at}
		}
		seen = put(seen, file.at.filename, true)
		var prefix List[SyntaxNode]
		rest := sorted
		for head(rest).ok && head(rest).value.at.filename < file.at.filename {
			prefix = prepend(head(rest).value, prefix)
			rest = tail(rest)
		}
		sorted = prepend(file, rest)
		for _, previous := range prefix {
			sorted = prepend(previous, sorted)
		}
	}
	files = sorted
	checked := checkPackageInfo(files, true)
	if !checked.ok {
		return EmitResult{reason: checked.reason, at: checked.at}
	}
	e := Emitter{checked: checked, noOpt: noOpt}
	// Resolve variable uses to declaration identities once. Analysis, native
	// reads and cell addresses share this index; constants/functions need none.
	for _, definition := range checked.bindings.definitions {
		if definition.kind == "var" || definition.kind == "param" {
			key := sourceIdentity(definition.at)
			e.localKeys = put(e.localKeys, key, key)
		}
	}
	for _, reference := range checked.bindings.references {
		if reference.symbol.kind == "var" || reference.symbol.kind == "param" {
			e.localKeys = put(e.localKeys, sourceIdentity(reference.at), sourceIdentity(reference.symbol.at))
		}
	}
	var reversed List[string]
	mainFound := false
	for _, file := range files {
		for _, declaration := range tail(file.children) {
			if declaration.kind == "FuncDecl" {
				if childAt(declaration, 0).text == "main" {
					mainFound = true
				}
				reversed = prepend(emitFunction(&e, declaration), reversed)
			} else if declaration.kind != "GenDecl" || (declaration.text != "const" && declaration.text != "type") {
				emitFail(&e, declaration.at, "bootstrap emitter supports functions, structs, and top-level constants")
			}
		}
	}
	if !mainFound {
		emitFail(&e, head(files).value.at, "a func main() entry point is required")
	}
	if e.reason != "" {
		return EmitResult{reason: e.reason, at: e.at}
	}
	var functions List[string]
	for _, function := range reversed {
		functions = prepend(function, functions)
	}
	module := "%% Generated by the linglang bootstrap emitter.\n-module(linglang_program).\n-export([main/0]).\n\nmain() -> try " + emitFunctionName("main") + "() after linglang_rt:finish_process() end.\n\n" + join(functions, "\n\n") + "\n"
	return EmitResult{ok: true, module: module}
}

func emitFunction(e *Emitter, node SyntaxNode) string {
	emitAnalyzeLocals(e, node)
	name := childAt(node, 0)
	if name.text == "init" || name.text == "_" {
		emitFail(e, name.at, "init and blank function declarations are unsupported")
	}
	signature := get(e.checked.types, emitDefinition(e, name).typeID).value
	if signature.result != tVoid {
		emitRequireType(e, signature.result, name.at)
	}
	if signature.result != tVoid && !emitTerminates(e, childAt(node, 3)) {
		emitFail(e, name.at, "missing return")
	}
	var args List[string]
	var setup List[string]
	for _, field := range childAt(node, 1).children {
		names := childAt(field, 0).children
		if !head(names).ok {
			args = append(args, emitFresh(e))
		} else {
			for _, parameter := range names {
				arg := emitFresh(e)
				args = append(args, arg)
				if parameter.text != "_" {
					setup = append(setup, emitDeclareLocal(e, parameter, arg))
				}
			}
		}
	}
	for _, id := range signature.params {
		emitRequireType(e, id, name.at)
	}
	e.ret = emitFresh(e)
	setup = append(setup, e.ret+" = make_ref()")
	value := emitFresh(e)
	body := emitBlock(e, childAt(node, 3))
	setup = append(setup, "try "+body+" catch throw:{linglang_return, "+e.ret+", "+value+"} -> "+value+" end")
	return emitFunctionName(name.text) + "(" + join(args, ", ") + ") ->\n    " + emitScope(join(setup, ",\n    ")) + "."
}

// Conservative flow checking for the supported subset. Unsupported statements
// are still emitted/validated after a terminating statement, then rejected.
func emitTerminates(e *Emitter, node SyntaxNode) bool {
	if node.kind == "ReturnStmt" {
		return true
	}
	if node.kind == "BlockStmt" || node.kind == "Body" {
		for _, statement := range node.children {
			if emitTerminates(e, statement) {
				return true
			}
		}
	}
	if node.kind == "IfStmt" {
		return emitTerminates(e, childAt(node, 2)) && emitTerminates(e, childAt(node, 3))
	}
	if node.kind == "ForStmt" {
		return childAt(node, 1).kind == "nil" && !emitLoopHasBreak(childAt(node, 3))
	}
	if node.kind == "SwitchStmt" {
		defaultFound := false
		for _, clause := range childAt(node, 2).children {
			if !head(childAt(clause, 0).children).ok {
				defaultFound = true
			}
			body := childAt(clause, 1)
			if emitLoopHasBreak(body) || !emitTerminates(e, body) {
				return false
			}
		}
		return defaultFound
	}
	if node.kind == "ExprStmt" {
		call := childAt(node, 0)
		if call.kind == "CallExpr" {
			callee := emitValue(e, emitCallee(childAt(call, 0)))
			return callee.kind == "intrinsic" && callee.name == "panic"
		}
	}
	return false
}

// A nested loop or switch owns its breaks. This also checks a switch case body
// for breaks targeting that switch when deciding whether every case terminates.
func emitLoopHasBreak(body SyntaxNode) bool {
	pending := List[SyntaxNode]{body}
	for head(pending).ok {
		node := head(pending).value
		pending = tail(pending)
		if node.kind == "BranchStmt" && node.text == "break" {
			return true
		}
		if node.kind != "ForStmt" && node.kind != "RangeStmt" && node.kind != "SwitchStmt" {
			for _, child := range node.children {
				pending = prepend(child, pending)
			}
		}
	}
	return false
}
