package main

type BootstrapOptions struct {
	command   string
	output    string
	paths     List[string]
	arguments List[string]
	stress    bool
	stats     bool
	help      bool
	noOpt     bool
	timeout   int
	json      bool
	tests     bool
}

func bootstrapUsage() string {
	return "usage: linglang-bootstrap <check|emit|build|run|test|fmt|init|describe|deps> [options] <source.lang|directory>...\n  describe: [--json]\n  deps: [--check] [--json] [file|directory]\n  fmt: [--check] [file|directory ...]\n  init: [directory]\n  check/test: --json (structured output)\n  check: --tests (validate test/library roots)\n  compiler: --no-opt (original cell lowering)\n  build: -o <executable> (default: program.escript)\n  build/run/test: --gc-stress --gc-stats\n  test: --timeout <positive milliseconds or Ns/Nms> (default: 30s)\n  run: -- <program arguments>\n  source paths without a command retain legacy emit behavior"
}

func bootstrapOptions(values List[string]) BootstrapOptions {
	options := BootstrapOptions{command: "emit", output: "program.escript", timeout: 30000}
	first := head(values).value
	if first == "--help" || first == "-h" {
		options.help = true
		return options
	}
	if first == "check" || first == "emit" || first == "build" || first == "run" || first == "test" {
		options.command = first
		values = tail(values)
	}
	for head(values).ok {
		value := head(values).value
		values = tail(values)
		if value == "--" {
			if options.command != "run" {
				panic("program arguments require run")
			}
			options.arguments = values
			break
		}
		if value == "--timeout" {
			if options.command != "test" || !head(values).ok {
				panic("--timeout requires test and a duration")
			}
			options.timeout = bootstrapTestTimeout(head(values).value)
			values = tail(values)
		} else if value == "--json" {
			if options.command != "check" && options.command != "test" {
				panic("--json requires check or test")
			}
			options.json = true
		} else if value == "--tests" {
			if options.command != "check" {
				panic("--tests requires check")
			}
			options.tests = true
		} else if value == "--no-opt" {
			options.noOpt = true
		} else if value == "-o" {
			if options.command != "build" || !head(values).ok || head(values).value == "" {
				panic("-o requires build and an output path")
			}
			options.output = head(values).value
			values = tail(values)
		} else if value == "--gc-stress" || value == "--gc-stats" {
			if options.command != "build" && options.command != "run" && options.command != "test" {
				panic("GC options require build, run, or test")
			}
			if value == "--gc-stress" {
				options.stress = true
			} else {
				options.stats = true
			}
		} else {
			if len(value) > 0 && byteAt(value, 0) == 45 {
				panic("unknown option " + value)
			}
			options.paths = append(options.paths, value)
		}
	}
	if !head(options.paths).ok && options.command == "test" {
		options.paths = List[string]{"."}
	}
	if !head(options.paths).ok {
		panic(bootstrapUsage())
	}
	if (options.command == "test" || options.tests) && len(options.paths) != 1 {
		panic("test and check --tests expect one source file or directory")
	}
	return options
}

func bootstrapParse(filenames List[string]) ToolFiles {
	var reversed List[SyntaxNode]
	var seen Map[string, bool]
	for _, filename := range filenames {
		if get(seen, filename).ok {
			return ToolFiles{issue: ToolIssue{code: "LL1002", reason: "duplicate source file " + filename}}
		}
		seen = put(seen, filename, true)
		input := readFile(filename)
		if !input.ok {
			return ToolFiles{issue: ToolIssue{code: "LL1000", reason: "cannot read " + filename + ": " + input.reason}}
		}
		parsed := parse(filename, input.value)
		if !parsed.ok {
			return ToolFiles{issue: ToolIssue{code: "LL1001", reason: parsed.reason, at: Token{filename: filename, offset: parsed.offset, line: parsed.line, column: parsed.column}}}
		}
		reversed = prepend(parsed.root, reversed)
	}
	return ToolFiles{files: syntaxOrder(reversed)}
}

func main() {
	values := args()
	if head(values).value == "describe" {
		bootstrapDescribe(tail(values))
		return
	}
	if head(values).value == "deps" {
		bootstrapDeps(tail(values))
		return
	}
	if head(values).value == "fmt" {
		bootstrapFormat(tail(values))
		return
	}
	if head(values).value == "init" {
		bootstrapInit(tail(values))
		return
	}
	options := bootstrapOptions(args())
	if options.help {
		println(bootstrapUsage())
		return
	}
	if options.command == "test" {
		bootstrapTest(options)
		return
	}
	loaded := toolLoad(options)
	if loaded.issue.code != "" {
		toolFailure(options, loaded.count, loaded.issue)
		return
	}
	files := loaded.files
	result := emitPackageMode(files, options.noOpt, options.tests)
	if !result.ok {
		toolFailure(options, loaded.count, ToolIssue{code: result.code, reason: result.reason, at: result.at})
		return
	}
	// Check the same supported program subset as build/run, including return
	// flow and entry-point validation, while withholding the emitted module.
	if options.command == "check" {
		if options.json {
			toolReport(toolCheckJSON(options, loaded.count, ToolIssue{}), true)
		}
		return
	}
	if options.command == "emit" {
		print(result.module)
	} else if options.command == "build" {
		var inputs List[string]
		for _, file := range files {
			inputs = append(inputs, file.at.filename)
		}
		built := buildProgram(result.module, options.output, inputs, options.stress, options.stats)
		if !built.ok {
			panic(built.reason)
		}
		println("Built executable in " + options.output)
	} else {
		ran := runProgram(result.module, options.arguments, options.stress, options.stats)
		if !ran.ok {
			panic(ran.reason)
		}
	}
}
