package main

func TestFormatterPreservesSyntaxAndIsIdempotent() {
	for _, body := range (List[string]{
		"func main(){x:=1; x++;println(x)}",
		"// a comment\nfunc main(){ // keep me\nx := `raw\n  body`;println(x) /* tail */}\n",
		"import x \"./missing\"\nfunc main(){x.Missing()}",
		"func main(){for i:=0;i<3;i++{if x:=i;x>0{println(x)}else{println(0)}}}",
		"func main(){for ;true;{break};for{};if ;true{}}",
		"type N struct{x int;next *N};func f(p **N)*N{return *p}",
		"func main(){x:=1;println(- -x, + +x, & ^x)}",
		"func main(){for _,n:=range (List[int]{1,2}){println(n)}}",
		"const(A=iota;B);func main(){switch x:=1;x{case 1,2:println(x);default:println(0)}}",
		"func main(){switch{case get(Map[int,int]{1:2},1).ok:println(1);default:}}",
		"func main(){f(\n1,\n2,\n)}",
		"func main(){x:=List[int]{\n1,\n2,\n};println(x)}",
		"func main(){;println(1);;}",
		"func main(){x:=1 /* multi\nline */;println(x)}",
		"func main(){for range (List[\n// bean\nint,\n] /* keep */ {1}) {println(1)}}",
		"func main(){if (List[\n// element\nint,\n] /* between */ {1} != nil) {println(1)}}",
		"func main(){x := Map[\n// key\nstring,\n// value\nList[\n// element\nint,\n],\n] /* between */ {\"bean\": List[int]{1}}; println(len(x))}",
		"func main(){println(\"雪\\x00\",'a')}",
	}) {
		source := "package main\n" + body
		result := formatSourceText("sample.lang", source)
		if !result.ok {
			panic(result.reason + "\n" + source)
		}
		second := formatSourceText("sample.lang", result.value)
		assert(second.ok && second.value == result.value)
	}
	assert(!formatSourceText("bad.lang", "package main\nfunc {").ok)
	assert(!formatSourceText("unsupported.lang", "package main\nfunc main(){defer f()}").ok)
}

func TestFormatterLayoutAndComments() {
	formatted := formatSourceText("main.lang", "package main;func main(){x:=1;println(x)}")
	assert(formatted.ok)
	assert(formatted.value == "package main\n\nfunc main() {\n\tx := 1\n\tprintln(x)\n}\n")
	comment := "/* verbatim\n    indentation\n*/"
	formatted = formatSourceText("comment.lang", "package main\n"+comment+"\nfunc main(){println(`raw\n  text`)} // final")
	assert(formatted.ok)
	assert(len(split(formatted.value, comment)) == 2)
	assert(len(split(formatted.value, "`raw\n  text`")) == 2)
	assert(textEnds(formatted.value, "// final\n"))
}
