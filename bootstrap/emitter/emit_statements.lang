package main

func emitBlock(e *Emitter, node SyntaxNode) string {
	values := e.values
	var parts List[string]
	for _, statement := range node.children {
		parts = append(parts, "linglang_rt:safepoint()")
		parts = append(parts, emitStatement(e, statement))
	}
	parts = append(parts, "ok")
	if e.straight {
		return "(begin " + join(parts, ",\n        ") + " end)"
	}
	// The generated scope is a closure. Its declarations dominate reads inside
	// that closure, but must not become available to sibling or outer scopes.
	e.values = values
	return emitScope(join(parts, ",\n        "))
}

func emitVariables(e *Emitter, node SyntaxNode) string {
	if node.text == "const" {
		return "ok"
	}
	if node.text != "var" {
		emitFail(e, node.at, "bootstrap emitter does not support local types")
		return ""
	}
	var parts List[string]
	for _, spec := range node.children {
		names := childAt(spec, 0).children
		values := childAt(spec, 2).children
		value := ""
		if head(values).ok {
			value = emitResults(e, values)
		} else {
			var zeros List[string]
			for _, name := range names {
				zero := "ok"
				if name.text != "_" {
					zero = emitZero(e, emitDefinition(e, name).typeID, name.at)
				}
				zeros = append(zeros, zero)
			}
			value = head(zeros).value
			if len(zeros) > 1 {
				value = "{" + join(zeros, ", ") + "}"
			}
		}
		parts = append(parts, emitAssignResults(e, names, value))
	}
	return "(begin " + join(parts, ", ") + " end)"
}

func emitAssignment(e *Emitter, node SyntaxNode) string {
	lhs := childAt(node, 0).children
	rhs := childAt(node, 1).children
	if len(lhs) > 1 && (node.text == "=" || node.text == ":=") {
		return emitAssignResults(e, lhs, emitResults(e, rhs))
	}
	if len(lhs) != 1 || len(rhs) != 1 {
		emitFail(e, node.at, "compound assignment requires one target and value")
		return ""
	}
	target := head(lhs).value
	value := emitExpression(e, head(rhs).value, false)
	if target.kind == "Ident" && target.text == "_" {
		return emitScope(value)
	}
	if node.text == ":=" {
		id := emitDefinition(e, target).typeID
		emitRequireType(e, id, target.at)
		return emitDeclareLocal(e, target, emitScope(value))
	}
	key := emitLocalKey(e, target)
	if get(e.valueLocals, key).value {
		if node.text != "=" {
			op := slice(node.text, 0, len(node.text)-1)
			if op == "<<" || op == ">>" {
				value = emitShiftCount(e, head(rhs).value)
			}
			value = emitOrdered(e, List[string]{get(e.values, key).value, value}, List[int]{emitValue(e, target).typeID, emitValue(e, head(rhs).value).typeID}, "fun(A, B) -> linglang_rt:binary("+emitOperator(op)+", A, B) end")
		}
		return emitAssignValue(e, key, emitScope(value))
	}
	// Evaluate and root the destination before the RHS can overwrite its last
	// alias or collect. Read a compound-assignment value before evaluating RHS.
	address := emitAddress(e, target)
	cell := emitFresh(e)
	setup := cell + " = " + address + ", linglang_rt:keep(" + cell + "), "
	if node.text != "=" {
		op := slice(node.text, 0, len(node.text)-1)
		if op == "<<" || op == ">>" {
			value = emitShiftCount(e, head(rhs).value)
		}
		value = emitOrdered(e, List[string]{"linglang_rt:read(" + cell + ")", value}, List[int]{emitValue(e, target).typeID, emitValue(e, head(rhs).value).typeID}, "fun(A, B) -> linglang_rt:binary("+emitOperator(op)+", A, B) end")
	}
	return emitScope(setup + "linglang_rt:write(" + cell + ", " + value + ")")
}

func emitFor(e *Emitter, node SyntaxNode) string {
	initializer := childAt(node, 0)
	init := emitStatement(e, initializer)
	var initials List[string]
	var iterations List[string]
	var keys List[string]
	if initializer.kind == "AssignStmt" && initializer.text == ":=" {
		for _, name := range childAt(initializer, 0).children {
			key := sourceIdentity(name.at)
			if name.text != "_" && !get(e.valueLocals, key).value {
				initials = append(initials, emitCell(e, name, true))
				iteration := emitFresh(e)
				iterations = append(iterations, iteration)
				keys = append(keys, key)
				e.cells = put(e.cells, key, iteration)
			}
		}
	}
	condition := "true"
	if childAt(node, 1).kind != "nil" {
		condition = emitExpression(e, childAt(node, 1), false)
	}
	post := emitStatement(e, childAt(node, 2))
	loop := emitFresh(e)
	e.loops = prepend(loop, e.loops)
	e.breaks = prepend(loop, e.breaks)
	body := emitStatement(e, childAt(node, 3))
	e.breaks = tail(e.breaks)
	e.loops = tail(e.loops)
	if head(iterations).ok {
		old := initials
		for _, key := range keys {
			e.cells = put(e.cells, key, head(old).value)
			old = tail(old)
		}
		pattern := "[" + join(iterations, ", ") + "]"
		return emitScope(init + ", " + loop + " = make_ref(), linglang_rt:loop_cells(fun(" + pattern + ") -> " + condition + " end, fun(" + pattern + ") -> " + body + " end, fun(" + pattern + ") -> " + post + " end, " + loop + ", [" + join(initials, ", ") + "])")
	}
	return emitScope(init + ", " + loop + " = make_ref(), linglang_rt:loop(fun() -> " + condition + " end, fun() -> " + body + " end, fun() -> " + post + " end, " + loop + ")")
}

func emitStatement(e *Emitter, node SyntaxNode) string {
	if e.reason != "" {
		return ""
	}
	switch node.kind {
	case "nil", "EmptyStmt":
		return "ok"
	case "BlockStmt":
		return emitBlock(e, node)
	case "RangeStmt":
		return emitRange(e, node)
	case "ForStmt":
		return emitFor(e, node)
	case "SwitchStmt":
		return emitSwitch(e, node)
	case "BranchStmt":
		targets := e.loops
		if node.text == "break" {
			targets = e.breaks
		}
		if !head(targets).ok || (node.text != "break" && node.text != "continue") {
			emitFail(e, node.at, "break requires a loop or switch; continue requires a loop")
			return ""
		}
		return "throw({linglang_" + node.text + ", " + head(targets).value + "})"
	case "DeclStmt":
		return emitVariables(e, childAt(node, 0))
	case "AssignStmt":
		return emitAssignment(e, node)
	case "ExprStmt":
		return emitScope(emitExpression(e, childAt(node, 0), false))
	case "ReturnStmt":
		value := emitResults(e, node.children)
		return emitScope("throw({linglang_return, " + e.ret + ", " + value + "})")
	case "IncDecStmt":
		target := childAt(node, 0)
		op := "add"
		if node.text == "--" {
			op = "sub"
		}
		key := emitLocalKey(e, target)
		if get(e.valueLocals, key).value {
			return emitAssignValue(e, key, "linglang_rt:binary("+op+", "+get(e.values, key).value+", 1)")
		}
		cell := emitFresh(e)
		return emitScope(cell + " = " + emitAddress(e, target) + ", linglang_rt:keep(" + cell + "), linglang_rt:write(" + cell + ", linglang_rt:binary(" + op + ", linglang_rt:read(" + cell + "), 1))")
	case "IfStmt":
		values := e.values
		init := emitStatement(e, childAt(node, 0))
		condition := emitScope(emitExpression(e, childAt(node, 1), false))
		body := emitStatement(e, childAt(node, 2))
		other := emitStatement(e, childAt(node, 3))
		e.values = values
		branch := "case " + condition + " of true -> " + body + "; false -> " + other + " end"
		if childAt(node, 0).kind != "nil" {
			// The initializer owns one lexical scope shared by the condition
			// and both branches, including an else-if. Escaping pointers are
			// retained by the outer roots when this scope unwinds.
			return emitScope(init + ", " + branch)
		}
		return branch
	}
	emitFail(e, node.at, "bootstrap emitter does not support statement "+node.kind)
	return ""
}
