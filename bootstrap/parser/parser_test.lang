package main

func parsedFunction(source string) SyntaxNode {
	result := parse("test.lang", "package main\n"+source)
	assert(result.ok)
	return childAt(result.root, 1)
}

func TestExpressionPrecedenceAndShape() {
	fn := parsedFunction("func main(){return 1 + 2*3 << 1 &^ 4}")
	body := childAt(fn, 3)
	value := childAt(childAt(body, 0), 0)
	assert(value.kind == "BinaryExpr" && value.text == "+")
	assert(childAt(value, 0).text == "1")
	right := childAt(value, 1)
	assert(right.text == "&^")
	assert(childAt(right, 0).text == "<<" && childAt(childAt(right, 0), 0).text == "*")
	fn = parsedFunction("func main(){return 1-2-3}")
	value = childAt(childAt(childAt(fn, 3), 0), 0)
	assert(value.text == "-" && childAt(value, 0).text == "-" && childAt(value, 1).text == "3")
	fn = parsedFunction("func main(){return !(a || b && c)}")
	value = childAt(childAt(childAt(fn, 3), 0), 0)
	assert(value.kind == "UnaryExpr" && value.text == "!")
	assert(childAt(childAt(value, 0), 0).text == "||")
}

func TestDeclarationsAndControlFlow() {
	result := parse("bean.lang", "package main\nconst(A=iota; B); type Node struct{x,y int; next *Node}; func f(x,y int) int {if n:=x+y;n>0{return n}else{return 0}}")
	assert(result.ok && result.root.kind == "File" && len(result.root.children) == 4)
	fn := childAt(result.root, 3)
	assert(len(childAt(fn, 1).children) == 1)
	assert(len(childAt(childAt(childAt(fn, 1), 0), 0).children) == 2)
	branch := childAt(childAt(fn, 3), 0)
	assert(branch.kind == "IfStmt" && childAt(branch, 0).kind == "AssignStmt")
	fn = parsedFunction("func main(){for i:=0;i<3;i++{continue}; for range (List[int]{1}){break}; switch x:=1;x{case 1,2:println(x);default:return}}")
	body := childAt(fn, 3)
	assert(childAt(body, 0).kind == "ForStmt" && childAt(body, 1).kind == "RangeStmt" && childAt(body, 2).kind == "SwitchStmt")
	assert(childAt(childAt(body, 1), 0).kind == "nil")
	assert(!parse("bad", "package main\nfunc main(){for a,b,c := range xs{}}").ok)
}

func TestParameterGroupsAndAnonymousStructs() {
	fn := parsedFunction("func f(int,*Node,List[int],string)int{return 1}")
	params := childAt(fn, 1)
	assert(len(params.children) == 4)
	for _, field := range params.children {
		assert(len(childAt(field, 0).children) == 0)
	}
	fn = parsedFunction("func f(x,y int,z *Node)(){}")
	assert(len(childAt(fn, 1).children) == 2 && len(childAt(fn, 2).children) == 0)
	assert(!parse("mixed", "package main\nfunc f(x int,string){}").ok)
	assert(parse("returns", "package main\nfunc f()(int,string){return 1,\"ok\"}").ok)
	assert(!parse("returns", "package main\nfunc f()(x int){}").ok)
	assert(parse("anonymous", "package main\nfunc main(){var x struct{n int}; x=struct{n int}{n:1}; if ;x.n>0{println(x)}}").ok)
}

func TestLiteralsCallsAndLocations() {
	fn := parsedFunction("func main(){return append(List[Node]{{n:1}}, receive[Node](1).value)}")
	call := childAt(childAt(childAt(fn, 3), 0), 0)
	assert(call.kind == "CallExpr" && len(call.children) == 3)
	literal := childAt(call, 1)
	assert(literal.kind == "CompositeLit" && childAt(literal, 0).kind == "IndexExpr")
	assert(childAt(childAt(literal, 1), 0).kind == "nil")
	result := parse("雪.lang", "\ufeffpackage main\n//line fake:100\nfunc main(){\n  return `a\r\nb`\n}")
	assert(result.ok && result.root.at.offset == 3 && result.root.at.column == 4)
	value := childAt(childAt(childAt(childAt(result.root, 1), 3), 0), 0)
	assert(value.at.line == 4 && value.at.column == 10 && value.text == "`a\r\nb`")
	result = parse("bad.lang", "package main\nfunc main(){\n  @\n}")
	assert(!result.ok && result.filename == "bad.lang" && result.line == 3 && result.column == 3)
}

func TestMalformedSyntaxReturnsDiagnostics() {
	for _, source := range (List[string]{"", "package", "package main\nfunc", "package main\nfunc main(){", "package main\nfunc main(){x:=}", "package main\nfunc main(){println(1 2)}", "package main\nfunc main(){x:=List[int]{1\n}}", "package main\nfunc main(){if true\n{}}", "package main\nfunc main(){if true{}\nelse{}}", "package main\nfunc main(){for i:=0;i<2;i:=1{}}", "package main\nfunc main(){switch x{case 1 println(x)}}", "package main\nfunc main(){return (1}", "package main\nconst(A)", "package main\nfunc main(){var x}", "package main\nfunc main(){x:=f[]()}", "package main\nfunc main(){x:=0x}", "package main\nfunc main(){/* unfinished", "package main\nfunc main(){println(\"\xff\")}", "package main\nfunc main(){defer println(1)}", "package main\ntype T = int", "package main\nfunc f[T any](){}", "package main\nfunc (t T) f(){}", "package main\nfunc main(){x:=[]int{1}}"}) {
		result := parse("bad.lang", source)
		assert(!result.ok && result.reason != "" && result.filename == "bad.lang")
		assert(result.offset >= 0 && result.offset <= len(source) && result.line > 0 && result.column > 0)
	}
}

func TestBracketArguments() {
	for _, expression := range (List[string]{"values[1+2]", "values[1+2,]", "f[1+2,int]()", "f[int,*Node,List[int],Map[string,int],struct{n int},(int),]()"}) {
		assert(parse("brackets.lang", "package main\nfunc main(){return "+expression+"}").ok)
	}
	for _, argument := range (List[string]{"1", "\"bean\"", "f()", "T{}", "int+1", "&Node", "!true", "List[1]"}) {
		result := parse("bad.lang", "package main\nfunc main(){return Map[string,"+argument+"]{}}")
		assert(!result.ok && result.reason != "" && result.filename == "bad.lang" && result.line == 2)
	}
	prefix := "package main\nfunc main(){receive[int, "
	result := parse("bad.lang", prefix+"1](0)}")
	assert(!result.ok && result.offset == len(prefix) && result.line == 2 && result.column == len(prefix)-len("package main\n")+1)
}

func TestPrefixesAndNestingLimit() {
	source := "package main\nfunc f(x int)int{for i:=0;i<x;i++{if i>1{return i*2}};return 0}"
	for end := 0; end <= len(source); end++ {
		result := parse("prefix", slice(source, 0, end))
		if result.ok {
			assert(result.root.kind == "File")
		} else {
			assert(result.reason != "" && result.offset >= 0 && result.offset <= end && result.line > 0)
		}
	}
	opening := ""
	closing := ""
	for i := 0; i < 150; i++ {
		opening += "("
		closing += ")"
	}
	result := parse("deep", "package main\nfunc main(){return "+opening+"1"+closing+"}")
	assert(!result.ok && result.reason == "syntax nesting exceeds 128 levels")
}
