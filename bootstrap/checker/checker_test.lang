func TestSwitchAndEntrySignatures() {
	for _, source := range (List[string]{
		"func f(){var xs List[int];switch xs{case nil:println(1)};var m Map[int,int];switch m{case nil:println(1)}}",
		"func main(){};func init(){}",
	}) {
		assert(checkedSource(source).ok)
	}
	for _, source := range (List[string]{
		"func f(){m:=Map[int,int]{};switch m{case Map[int,int]{}:println(1)}}",
		"func f(){xs:=List[int]{};switch xs{case List[int]{}:println(1)}}",
		"type N struct{xs List[int]};func f(){n:=N{};switch n{default:println(1)}}",
		"type N struct{m Map[int,int]};func f(){n:=N{};switch n{case N{}:println(1)}}",
		"func main(x int){println(x)}",
		"func main()int{return 1}",
		"func init(x int){println(x)}",
		"func init()bool{return true}",
	}) {
		assert(!checkedSource(source).ok)
	}
}

func TestInternalIdentities() {
	a := Token{filename: "a:\"雪\n.lang", offset: 12}
	b := Token{filename: "a:\"雪\n.lang:1", offset: 2}
	assert(sourceIdentity(a) != sourceIdentity(b))
	assert(expressionIdentity(SyntaxNode{at: a, id: 12}) != expressionIdentity(SyntaxNode{at: b, id: 2}))
	first := parse(a.filename, "package main\nfunc answer(n int)int{return n+1}")
	second := parse(b.filename, "package main\nfunc main(){n:=2;println(answer(n))}")
	checked := checkPackageInfo(List[SyntaxNode]{first.root, second.root}, true)
	assert(first.ok && second.ok && checked.ok && len(checked.definitions) == 4)
	function := head(tail(first.root.children)).value
	name := head(childAt(head(childAt(function, 1).children).value, 0).children).value
	assert(get(checked.definitions, sourceIdentity(name.at)).ok)
}
