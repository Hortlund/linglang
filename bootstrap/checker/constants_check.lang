package main

func constantKey(name SyntaxNode) string {
	if name.text == "_" {
		return quotedText(name.at.filename) + ":" + formatInt(name.at.offset)
	}
	return name.text
}

func registerConstants(c *Checker, scope *TypeScope, declarations List[SyntaxNode]) {
	for _, declaration := range declarations {
		if declaration.kind == "GenDecl" && declaration.text == "const" {
			previous := noSyntax()
			index := 0
			for _, spec := range declaration.children {
				initializer := spec
				if len(childAt(spec, 2).children) == 0 {
					initializer = previous
				} else {
					previous = spec
				}
				values := childAt(initializer, 2).children
				if len(values) != len(childAt(spec, 0).children) {
					checkFail(c, spec.at, "constant value count mismatch")
				}
				for _, name := range childAt(spec, 0).children {
					c.constants = put(c.constants, constantKey(name), PendingConstant{name: name.text, value: head(values).value, declared: childAt(initializer, 1), at: name.at, iota: index})
					bindType(scope, name.text, "pending", tInvalid)
					values = tail(values)
				}
				index++
			}
		}
	}
}

func checkConstant(c *Checker, name string) {
	if c.reason != "" {
		return
	}
	state := get(c.constantState, name).value
	constant := get(c.constants, name).value
	if state == 2 {
		return
	}
	if state == 1 {
		checkFail(c, constant.at, "constant dependency cycle")
		return
	}
	c.constantState = put(c.constantState, name, 1)
	id := tInvalid
	if constant.declared.kind != "nil" {
		id = typeSyntax(c, c.global, constant.declared)
	}
	previousIota := c.iota
	c.iota = constant.iota
	c.constantDepth++
	value := checkExpression(c, c.global, constant.value, id)
	c.constantDepth--
	c.iota = previousIota
	if id != tInvalid {
		requireType(c, constant.value, value, id)
	} else {
		id = value.typeID
		if value.kind != "value" || id == tNil || id == tVoid {
			checkFail(c, constant.at, "constant requires a typed value")
		}
	}
	if !integerType(id) && defaultType(id) != tBool && defaultType(id) != tString {
		checkFail(c, constant.at, "constant requires int, bool, or string")
	}
	if value.constant.kind == "" {
		checkFail(c, constant.at, "constant requires a constant expression")
	}
	bindConstant(c.global, constant.name, id, value.constant)
	if c.record && constant.name != "_" {
		c.definitions = put(c.definitions, sourceIdentity(constant.at), typedName(c.global, constant.name).value)
	}
	c.constantState = put(c.constantState, name, 2)
}
