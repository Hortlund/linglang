package main

const (
	tInvalid = iota
	tInt
	tBool
	tString
	tUntypedInt
	tUntypedBool
	tUntypedString
	tUntypedRune
	tRune
	tNil
	tVoid
)

type CheckedField struct {
	name   string
	typeID int
}

type CheckedType struct {
	kind   string
	name   string
	elem   int
	key    int
	fields List[CheckedField]
	params List[int]
	result int
}

type CheckedBinding struct {
	at       Token
	kind     string
	typeID   int
	constant ConstantValue
}

type TypeScope struct {
	names  Map[string, CheckedBinding]
	parent *TypeScope
}

type CheckedValue struct {
	name        string
	typeID      int
	messageType int
	addressable bool
	kind        string
	constant    ConstantValue
	integers    List[DeferredInteger]
}

// Untyped runtime expressions acquire their integer type from the enclosing
// context. Retain constant operands, including shifted operands, until then.
type DeferredInteger struct {
	at      Token
	integer ConstantInteger
}

type CheckResult struct {
	expressions Map[string, CheckedValue]
	definitions Map[string, CheckedBinding]
	types       Map[int, CheckedType]
	bindings    ResolveResult
	ok          bool
	reason      string
	at          Token
	constants   Map[string, ConstantValue]
}

type PendingConstant struct {
	name     string
	value    SyntaxNode
	declared SyntaxNode
	at       Token
	iota     int
}

type Checker struct {
	nativeNames   List[string]
	record        bool
	expressions   Map[string, CheckedValue]
	definitions   Map[string, CheckedBinding]
	mapReferences List[Reference]
	native        *TypeScope
	global        *TypeScope
	constants     Map[string, PendingConstant]
	constantState Map[string, int]
	constantDepth int
	iota          int
	literals      Map[string, ConstantValue]
	types         Map[int, CheckedType]
	interned      Map[string, int]
	next          int
	reason        string
	at            Token
	depth         int
}

func checkFail(c *Checker, at Token, reason string) {
	if c.reason == "" {
		c.reason = reason
		c.at = at
	}
}

func checkedType(c *Checker, id int) CheckedType {
	return get(c.types, id).value
}

func addType(c *Checker, value CheckedType) int {
	c.next++
	c.types = put(c.types, c.next, value)
	return c.next
}

func compoundType(c *Checker, kind string, key int, elem int) int {
	name := kind + ":" + formatInt(key) + ":" + formatInt(elem)
	found := get(c.interned, name)
	if found.ok {
		return found.value
	}
	id := addType(c, CheckedType{kind: kind, key: key, elem: elem})
	c.interned = put(c.interned, name, id)
	return id
}

func typedName(scope *TypeScope, name string) Delivery[CheckedBinding] {
	for scope != nil {
		found := get(scope.names, name)
		if found.ok {
			return found
		}
		scope = scope.parent
	}
	return Delivery[CheckedBinding]{}
}

func bindType(scope *TypeScope, name string, kind string, id int) {
	if name != "_" {
		scope.names = put(scope.names, name, CheckedBinding{kind: kind, typeID: id})
	}
}

func defaultType(id int) int {
	switch id {
	case tUntypedInt:
		return tInt
	case tUntypedBool:
		return tBool
	case tUntypedString:
		return tString
	case tUntypedRune:
		return tRune
	}
	return id
}

func assignable(c *Checker, from int, to int) bool {
	if from == tInvalid || to == tInvalid {
		return false
	}
	if from == to || (from >= tUntypedInt && from <= tUntypedString && defaultType(from) == to) || (untypedInteger(from) && (to == tInt || to == tRune || untypedInteger(to))) {
		return true
	}
	if from == tNil {
		kind := checkedType(c, to).kind
		return kind == "pointer" || kind == "list" || kind == "map" || kind == "handle"
	}
	return false
}

func requireType(c *Checker, node SyntaxNode, value CheckedValue, expected int) {
	if value.kind != "value" || !assignable(c, value.typeID, expected) {
		checkFail(c, node.at, "incompatible value type")
	}
	if expected == tRune && value.constant.kind == "" {
		checkFail(c, node.at, "runtime rune expressions are unsupported; use an int context")
	}
	if value.constant.kind == "int" && (expected == tInt || expected == tRune) {
		if !integerFitsType(value.constant.integer, expected) {
			checkFail(c, node.at, "constant overflows integer type")
		}
	}
	if expected == tInt || expected == tRune {
		for _, operand := range value.integers {
			if !integerFitsType(operand.integer, expected) {
				checkFail(c, operand.at, "constant operand overflows integer type")
			}
		}
	}
}

func integerFitsType(value ConstantInteger, expected int) bool {
	return integerFitsInt(value) && (expected != tRune || (integerCompare(value, integerSmall(-2147483648)) >= 0 && integerCompare(value, integerSmall(2147483647)) <= 0))
}

func typeSyntax(c *Checker, scope *TypeScope, node SyntaxNode) int {
	if c.reason != "" {
		return tInvalid
	}
	switch node.kind {
	case "Ident":
		binding := typedName(scope, node.text)
		if binding.ok && binding.value.kind == "type" {
			return binding.value.typeID
		}
	case "ParenExpr":
		return typeSyntax(c, scope, childAt(node, 0))
	case "StarExpr":
		return compoundType(c, "pointer", 0, typeSyntax(c, scope, childAt(node, 0)))
	case "IndexExpr", "IndexListExpr":
		base := childAt(node, 0)
		binding := typedName(scope, base.text)
		if binding.ok && binding.value.kind == "generic" {
			if (base.text == "List" || base.text == "Delivery" || base.text == "CallResult") && len(node.children) == 2 {
				kind := "list"
				if base.text == "Delivery" {
					kind = "delivery"
				}
				if base.text == "CallResult" {
					kind = "callresult"
				}
				return compoundType(c, kind, 0, typeSyntax(c, scope, childAt(node, 1)))
			}
			if base.text == "Map" && len(node.children) == 3 {
				key := typeSyntax(c, scope, childAt(node, 1))
				if key != tInt && key != tString {
					checkFail(c, base.at, "Map keys must be int or string")
				}
				return compoundType(c, "map", key, typeSyntax(c, scope, childAt(node, 2)))
			}
		}
	}
	checkFail(c, node.at, "expected a supported type")
	return tInvalid
}

func fieldType(c *Checker, id int, name string) int {
	t := checkedType(c, id)
	if t.kind == "pointer" {
		t = checkedType(c, t.elem)
	}
	if t.kind == "callresult" {
		if name == "timedOut" {
			return tBool
		}
		if name == "reason" {
			return tString
		}
	}
	if t.kind == "delivery" || t.kind == "callresult" {
		if name == "value" {
			return t.elem
		}
		if name == "ok" {
			return tBool
		}
	}
	for _, field := range t.fields {
		if field.name == name {
			return field.typeID
		}
	}
	return tInvalid
}

// The final colon separates a raw filename from a decimal position. Filenames
// may contain colons, quotes, or newlines; decimal positions cannot, so this
// key is injective without repeatedly escaping every byte of the filename.
func sourceIdentity(at Token) string { return at.filename + ":" + formatInt(at.offset) }
func expressionIdentity(node SyntaxNode) string {
	return node.at.filename + ":" + formatInt(node.id)
}
func rememberDefinition(c *Checker, scope *TypeScope, node SyntaxNode) {
	if c.record && node.text != "_" {
		binding := typedName(scope, node.text).value
		binding.at = node.at
		scope.names = put(scope.names, node.text, binding)
		c.definitions = put(c.definitions, sourceIdentity(node.at), binding)
	}
}

// Identifier literal keys are ambiguous until their composite type is known.
// Resolve runtime Map keys from the current type scope, whose definitions retain
// their source identity. Struct fields remain deferred, even if a local shares
// their name; folded constants need no managed-cell binding.
func rememberMapKey(c *Checker, scope *TypeScope, key SyntaxNode) {
	if c.record && c.reason == "" && key.kind == "Ident" {
		binding := typedName(scope, key.text).value
		if binding.kind == "var" || binding.kind == "param" {
			c.mapReferences = prepend(Reference{at: key.at, symbol: Symbol{name: key.text, kind: binding.kind, at: binding.at}}, c.mapReferences)
		}
	}
}

func completeMapBindings(c *Checker, bindings ResolveResult) ResolveResult {
	if !head(c.mapReferences).ok {
		return bindings
	}
	bindings.references = append(bindings.references, orderedReferences(c.mapReferences)...)
	var resolved Map[string, bool]
	for _, reference := range c.mapReferences {
		resolved = put(resolved, sourceIdentity(reference.at), true)
	}
	var deferred List[Token]
	for _, at := range bindings.deferred {
		if !get(resolved, sourceIdentity(at)).ok {
			deferred = prepend(at, deferred)
		}
	}
	bindings.deferred = tokenOrder(deferred)
	return bindings
}
