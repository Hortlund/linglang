package main

// Match the seed's bound without allocating expanded strings just to check it.
const maxConstantStringBytes = 2000000000
const inlineConstantStringBytes = 4096

// A package-local table stores immutable rope nodes. Children use integer IDs,
// not pointers or nested native trees: even an untyped GC root scan stays bounded
// by the node count instead of expanding shared subtrees. Carry this table with
// its constants; IDs from independent package checks must never be mixed.
type ConstantStringNode struct {
	left  ConstantValue
	right ConstantValue
}

func constantStringLength(value ConstantValue) int {
	if value.rope != 0 {
		return value.size
	}
	return len(value.text)
}

func concatenateConstantStrings(c *Checker, node SyntaxNode, a ConstantValue, b ConstantValue) ConstantValue {
	left := constantStringLength(a)
	right := constantStringLength(b)
	if left > maxConstantStringBytes-right {
		checkFail(c, node.at, "constant string exceeds size limit")
		return ConstantValue{}
	}
	if left == 0 {
		return b
	}
	if right == 0 {
		return a
	}
	if left+right <= inlineConstantStringBytes {
		return constantString(a.text + b.text)
	}
	c.nextString++
	c.stringNodes = put(c.stringNodes, c.nextString, ConstantStringNode{left: a, right: b})
	return ConstantValue{kind: "string", rope: c.nextString, size: left + right}
}

// Consumers that need actual bytes materialize once, rather than at every +.
func constantStringBytes(value ConstantValue, nodes Map[int, ConstantStringNode]) string {
	if value.rope == 0 {
		return value.text
	}
	pending := List[ConstantValue]{value}
	var reversed List[string]
	for head(pending).ok {
		part := head(pending).value
		pending = tail(pending)
		if part.rope == 0 {
			reversed = prepend(part.text, reversed)
		} else {
			branch := get(nodes, part.rope)
			assert(branch.ok)
			pending = prepend(branch.value.left, prepend(branch.value.right, pending))
		}
	}
	var parts List[string]
	for _, part := range reversed {
		parts = prepend(part, parts)
	}
	return join(parts, "")
}

// Compare aligned chunks. Shared subtrees can be skipped in constant time,
// including gigantic prefixes in expressions such as (S+"a") < (S+"b").
func compareConstantStrings(a ConstantValue, b ConstantValue, nodes Map[int, ConstantStringNode]) int {
	as := List[ConstantValue]{a}
	bs := List[ConstantValue]{b}
	for head(as).ok && head(bs).ok {
		x := head(as).value
		y := head(bs).value
		if (x.rope != 0 && x.rope == y.rope) || (x.rope == 0 && y.rope == 0 && x.text == y.text) {
			as = tail(as)
			bs = tail(bs)
		} else if x.rope != 0 && (y.rope == 0 || constantStringLength(x) >= constantStringLength(y)) {
			branch := get(nodes, x.rope)
			assert(branch.ok)
			as = prepend(branch.value.left, prepend(branch.value.right, tail(as)))
		} else if y.rope != 0 {
			branch := get(nodes, y.rope)
			assert(branch.ok)
			bs = prepend(branch.value.left, prepend(branch.value.right, tail(bs)))
		} else {
			n := len(x.text)
			if len(y.text) < n {
				n = len(y.text)
			}
			left := slice(x.text, 0, n)
			right := slice(y.text, 0, n)
			if left < right {
				return -1
			}
			if left > right {
				return 1
			}
			as = tail(as)
			bs = tail(bs)
			if n < len(x.text) {
				as = prepend(constantString(slice(x.text, n, len(x.text))), as)
			}
			if n < len(y.text) {
				bs = prepend(constantString(slice(y.text, n, len(y.text))), bs)
			}
		}
	}
	if head(as).ok {
		return 1
	}
	if head(bs).ok {
		return -1
	}
	return 0
}

type ConstantKeys struct {
	small     Map[string, bool]
	large     List[ConstantValue]
	duplicate bool
}

// Large string keys retain their shared representation. Only small keys need
// a flattened identity, so duplicate checking cannot allocate giant binaries.
func recordConstantKey(keys ConstantKeys, value ConstantValue, nodes Map[int, ConstantStringNode]) ConstantKeys {
	keys.duplicate = false
	if value.kind == "string" && constantStringLength(value) > inlineConstantStringBytes {
		for _, previous := range keys.large {
			if constantStringLength(previous) == constantStringLength(value) && compareConstantStrings(previous, value, nodes) == 0 {
				keys.duplicate = true
				return keys
			}
		}
		keys.large = prepend(value, keys.large)
		return keys
	}
	key := constantIdentity(value, nodes)
	if key != "" {
		keys.duplicate = get(keys.small, key).ok
		keys.small = put(keys.small, key, true)
	}
	return keys
}
